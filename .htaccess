# ============================================================
# FERRO DESIGN — ВЕБ-СЕРВЕРНАЯ ОПТИМИЗАЦИЯ И КЭШИРОВАНИЕ (.HTACCESS)
# ============================================================

# 1. Принудительная кодировка UTF-8
AddDefaultCharset UTF-8

# 2. Включение сжатия Gzip / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 3. Долгосрочное браузерное кэширование статики (1 год для шрифтов и картинок)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Шрифты WOFF2 / WOFF — кэшируются на 1 год (неизменяемые ресурсы)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Изображения WebP / PNG / JPG / SVG
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Стили и скрипты — 1 месяц (сброс версионированием ?v=...)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 4. Заголовки Cache-Control (параметр immutable для сверхбыстрого открытия из RAM браузера)
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|woff|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # Заголовки безопасности
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
